    "decayRules": {
        "_note": "Chaque cadavre réanimé porte une horloge de décomposition qui avance en jours de jeu, sans rien demander au nécromancien. Au franchissement d'un seuil, l'archétype change et les stats se recalculent sur le même corps, sans nouveau rituel. Squelette et Momie sont terminaux.",
        "speciesMismatch": {
            "_note": "Âme d'une espèce dans le corps d'une autre : possible, mais le corps lutte contre des réflexes qu'il ne peut pas suivre.",
            "precisionSteps": -2,
            "signatureAttackFactor": 0.5,
            "speedFactor": 0.75
        },
        "stageMismatch": {
            "_note": "Corps fourni au mauvais stade (improvisation) : mort-vivant instable, même logique que le Palier 3 des matériaux de Terre.",
            "effectFactor": 0.5,
            "precisionSteps": -2,
            "decayRate": 2
        },
        "embalming": {
            "_note": "Embaumement rituel : fige définitivement le stade actuel, au prix d'une préservation jamais gratuite. La perte se règle sur le sort (Perte de stats) ; ces valeurs sont celles du socle et le plancher.",
            "defaultStatLoss": 20,
            "minStatLoss": 10
        },
        "controlRange": {
            "base": 20,
            "perCha": 5
        }
